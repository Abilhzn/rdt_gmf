# Secrets — JANGAN PERNAH commit
.env
.env.*
confidential.txt

# Dependencies
node_modules/
package-lock.json.bak

# Build & runtime artifacts
dist/
build/
*.log
*.log.err

# Backend runtime data (bukan source, jangan ikut commit)
rdt/backend/staging/*
!rdt/backend/staging/.gitkeep
rdt/backend/uploads/*
!rdt/backend/uploads/.gitkeep
backend_run_output.txt
backend_server.log
backend_server.log.err

# Checklist 2.2 (12 Agu): logger.js's error.log, per service — *.log di atas sudah nutup ini juga,
# eksplisit di sini biar jelas kalau ada yang cari.
auth/logs/
data_user/logs/
rdt/backend/logs/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Claude Code local/runtime state — machine-specific, not shared config.
# settings.local.json in particular tends to accumulate secrets pasted into allow-listed
# Bash commands (DB passwords, etc.) over a session — never commit it.
.claude/settings.local.json
.claude/scheduled_tasks.lock
